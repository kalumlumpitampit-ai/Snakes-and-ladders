rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'teachertechsolution@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGame(data) {
      return data.keys().hasAll(['hostId', 'gameState', 'timerMinutes', 'players']) &&
             data.hostId is string &&
             data.gameState is string &&
             data.timerMinutes is number &&
             data.players is list &&
             data.players.size() <= 5;
    }

    match /admins/{uid} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isSignedIn() && request.auth.token.email == 'teachertechsolution@gmail.com';
    }

    match /admin_requests/{requestId} {
      allow get: if isSignedIn() && request.auth.uid == requestId;
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == requestId; // users create their own request
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /room_requests/{requestId} {
      allow read, write: if true;
    }

    match /games/{gameId} {
      allow get: if true; 
      allow list: if isAdmin();

      // Only admin can create a room
      allow create: if isAdmin() &&
                    isValidGame(incoming()) &&
                    incoming().hostId == request.auth.uid;

      // Anyone can update the game to join or play 
      // Strictly we should lock it down, but for a prototype, we'll allow all authenticated players to update
      allow update: if isValidGame(incoming());

      allow delete: if isAdmin();
    }
    
    match /game_history/{id} {
      allow read, write: if true;
    }
  }
}

