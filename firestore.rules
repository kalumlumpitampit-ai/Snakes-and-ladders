rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'kalumlumpitampit@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGame(data) {
      return data.keys().hasAll(['hostId', 'gameState', 'timerMinutes', 'players']) &&
             data.hostId is string &&
             data.gameState is string &&
             data.timerMinutes is number &&
             data.players is list &&
             data.players.size() <= 12; // Flexible limit
    }

    // Collections
    match /admins/{uid} {
      allow get: if true;
      allow list: if isAdmin();
      
      // Allow self-registration if they provide the secret key (given by main admin)
      // or if they are already an admin (promotion)
      allow create: if (isSignedIn() && request.auth.uid == uid && incoming().secret == 'admin112119') || 
                    isAdmin() || 
                    (isSignedIn() && request.auth.token.email == 'kalumlumpitampit@gmail.com');
      
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.token.email == 'kalumlumpitampit@gmail.com');
    }

    match /admin_requests/{requestId} {
      allow get: if isSignedIn() && request.auth.uid == requestId;
      allow list, update, delete: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == requestId; 
    }

    match /room_requests/{requestId} {
      allow read, write: if true; // Keeping simple for educational/public access as before
    }

    match /games/{gameId} {
      allow get: if true; 
      allow list: if isSignedIn() && (resource.data.hostId == request.auth.uid || isAdmin());

      // Ensure creation is safe
      allow create: if isSignedIn() &&
                    isValidId(gameId) &&
                    isValidGame(incoming()) &&
                    incoming().hostId == request.auth.uid;

      // Ensure updates keep hostId and are valid
      allow update: if (isSignedIn() && isValidGame(incoming()) && (incoming().hostId == existing().hostId || isAdmin())) ||
                    (isValidGame(incoming()) && incoming().hostId == existing().hostId);

      allow delete: if isAdmin() || (isSignedIn() && existing().hostId == request.auth.uid);
    }
    
    match /game_history/{id} {
      allow read: if isSignedIn() && (resource.data.hostId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().hostId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
