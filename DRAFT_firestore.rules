rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kalumlumpitampit@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validations
    function isValidGame(data) {
      return data.keys().hasAll(['hostId', 'gameState', 'timerMinutes', 'players']) &&
             data.hostId is string &&
             data.gameState is string &&
             data.gameState in ['setup', 'playing', 'finished'] &&
             data.timerMinutes is number &&
             data.players is list &&
             data.players.size() <= 6 &&
             // Optional/Other fields
             (!('questionTimerSeconds' in data) || data.questionTimerSeconds is number) &&
             (!('startedAt' in data) || data.startedAt == null || data.startedAt is number) &&
             (!('currentTurn' in data) || data.currentTurn is number) &&
             (!('lobby' in data) || data.lobby is map) &&
             (!('questionBank' in data) || data.questionBank is list) &&
             (!('questionIndex' in data) || data.questionIndex is number);
    }

    // Collections
    match /admins/{uid} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'kalumlumpitampit@gmail.com');
    }

    match /admin_requests/{requestId} {
      allow get: if isSignedIn() && request.auth.uid == requestId;
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == requestId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /room_requests/{requestId} {
      // For public users to request a room
      allow create: if true; 
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == requestId);
      allow update, delete: if isAdmin();
    }

    match /games/{gameId} {
      allow get: if true;
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && 
                    isValidId(gameId) &&
                    isValidGame(incoming()) &&
                    incoming().hostId == request.auth.uid;
      
      allow update: if (isSignedIn() && isValidGame(incoming())) || isAdmin();
      
      allow delete: if isAdmin() || (isSignedIn() && existing().hostId == request.auth.uid);
    }

    match /game_history/{historyId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().hostId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
